{
  "name": "dev-blog",
  "type": "module",
  "version": "0.2.2",
  "description": "Minimalist, typography-first Astro 7 theme crafted for technical writers and Obsidian vaults. Pure SSG, zero bloat.",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Renato Rezende (https://github.com/rnt-rez)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnt-rez/minrock.git"
  },
  "bugs": {
    "url": "https://github.com/rnt-rez/minrock/issues"
  },
  "homepage": "https://github.com/rnt-rez/minrock#readme",
  "keywords": [
    "astro",
    "astro-theme",
    "obsidian",
    "obsidian-vault",
    "obsidian-md",
    "obsidian-publish",
    "typography",
    "blog-theme",
    "ssg",
    "technical-writing",
    "minimalist"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "atro build && wrangler dev",
    "deploy": "wrangler deploy",
    "check": "astro check",
    "qa": "astro check && astro build",
    "audit:wcag": "node scripts/audit-wcag.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "audit:google": "node scripts/audit-google-search.mjs",
    "astro": "astro",
    "postinstall": "node scripts/sign-native-bindings.js"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd@1.20261001.1": true,
    "node@22.23.3": true
  }
}
